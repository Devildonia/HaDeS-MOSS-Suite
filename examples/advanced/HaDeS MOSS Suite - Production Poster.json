   "widgets_values": [
    "{\n  \"width\": 1024,\n  \"height\": 1536,\n  \"bbox_coord_space\": \"abs\",\n  \"bbox_format\": \"xyxy\",\n  \"summary\": {\n    \"caption\": \"A vertical festival poster featuring a woman in her forties playing the fiddle on the right against a twilight backdrop with a lighthouse on the left. The design uses a warm, rustic color palette of amber, deep blue, and wood tones with soft atmospheric lighting. Text elements are clearly legible in a bold serif font.\",\n    \"meta\": [\n      \"poster\",\n      \"folk music\",\n      \"night scene\",\n      \"lighthouse\",\n      \"typography\"\n    ]\n  },\n  \"items\": [\n    {\n      \"label\": \"text\",\n      \"caption\": \"Bold white serif text centered at the top reading VLEUTERWEIDE FOLK NIGHTS with a slight drop shadow for contrast against the sky.\",\n      \"bbox\": [\n        200,\n        60,\n        824,\n        140\n      ],\n      \"text\": \"VLEUTERWEIDE FOLK NIGHTS\"\n    },\n    {\n      \"label\": \"text\",\n      \"caption\": \"Small white sans-serif badge in the upper left corner inside a dark circular shape containing the word Zwanenburg.\",\n      \"bbox\": [\n        40,\n        180,\n        180,\n        240\n      ],\n      \"text\": \"Zwanenburg\"\n    },\n    {\n      \"label\": \"character\",\n      \"caption\": \"An adult woman in her forties with shoulder-length brown hair, wearing a traditional folk dress in earthy reds and greens, standing in profile facing left while energetically playing a wooden fiddle held under her chin, bow moving across strings.\",\n      \"bbox\": [\n        450,\n        250,\n        850,\n        1100\n      ]\n    },\n    {\n      \"label\": \"object\",\n      \"caption\": \"A tall stone lighthouse with a glowing lantern room situated on a rocky outcrop to the left, emitting a beam of light into the night sky, surrounded by silhouetted dunes.\",\n      \"bbox\": [\n        20,\n        250,\n        350,\n        1150\n      ]\n    },\n    {\n      \"label\": \"text\",\n      \"caption\": \"White serif text centered at the bottom against a dark footer strip reading Tickets at the door, 12 euros, doors open at 8 pm.\",\n      \"bbox\": [\n        250,\n        1350,\n        774,\n        1490\n      ],\n      \"text\": \"Tickets at the door, 12 euros,\\ndoors open at 8 pm\"\n    }\n  ]\n}"
